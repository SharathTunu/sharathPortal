# Copy this file to .env on your production server and fill in real values.
# NEVER commit .env to git.

# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string

# Set to False in production
DEBUG=False

# Comma-separated list of your domain(s), e.g: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Same domains prefixed with https://, required for CSRF to work behind Nginx
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- RAG / LLM settings ---
# LLM provider: "groq" (default) or "ollama"
RAG_LLM_PROVIDER=groq

# Groq (used when RAG_LLM_PROVIDER=groq)
# Get your free API key at https://console.groq.com
RAG_GROQ_API_KEY=your-groq-api-key-here
RAG_GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (used when RAG_LLM_PROVIDER=ollama — requires Ollama installed on the server)
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_MODEL=llama3.2

RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
